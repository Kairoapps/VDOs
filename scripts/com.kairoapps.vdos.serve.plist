<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kairoapps.vdos.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/vdos</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict><key>VDOS_ROOT</key><string>__REPO__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/vdos-serve.log</string>
  <key>StandardErrorPath</key><string>/tmp/vdos-serve.log</string>
</dict>
</plist>
