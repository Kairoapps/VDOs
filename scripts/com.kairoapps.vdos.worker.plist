<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kairoapps.vdos.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/vdos</string>
    <string>worker</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VDOS_ROOT</key><string>__REPO__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/vdos-worker.log</string>
  <key>StandardErrorPath</key><string>/tmp/vdos-worker.log</string>
</dict>
</plist>
