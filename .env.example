# Copy to .env (never committed) and fill in.

# Public HTTPS base that Tailscale Funnel exposes for media/edited, no trailing slash.
# Find it with: tailscale funnel status
PUBLIC_BASE_URL=https://your-mac.your-tailnet.ts.net

# Whisper model size: tiny | base | small | medium (small is a good speed/accuracy balance on Apple Silicon)
WHISPER_MODEL=small

# Filled in by the first daily run (Buffer IDs)
BUFFER_ORG_ID=
BUFFER_CH_INSTAGRAM=
BUFFER_CH_TIKTOK=
BUFFER_CH_YOUTUBE=
