# Secrets: never committed
.env

# Scratch / machine-specific
.venv/
__pycache__/
*.pyc
.DS_Store
work/*/frames/
work/.worker.lock
data/*.sqlite-journal
reports/dashboard.json
*.egg-info/

# Rendered videos live on the `publish` branch (served to Buffer), not on main
media/edited/*
!media/edited/.gitkeep
work/publish-branch/

# Audio without clear commercial rights stays local
sounds/unlicensed/

# Animations: node packages and render scratch stay local; the finished mp4 goes to media/edited -> publish branch
anim/lowpoly/node_modules/
anim/lowpoly/package-lock.json
work/anim/*/render/
work/anim/*/*.mp4
work/anim/*/*.wav
work/anim/_skills/
